@inherits LayoutComponentBase

<header class="top">
    <div>
        <p class="eyebrow">EF Core shop</p>
        <p class="title">Same order, two data layers</p>
    </div>
    <p class="hint">Place an order on both APIs. The anti-patterns column saves a customer-name change nobody asked to save.</p>
</header>

<main>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    The page hit an error.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>
